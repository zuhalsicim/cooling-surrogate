{
  "_comment": "CI smoke run: every stage on a tiny dataset in about a minute. The gate is loosened so that the small model reaches production and the image has something to serve; the numbers mean nothing.",
  "dataset": {"seed": 7, "n_train": 300, "n_val": 60, "n_test": 120, "n_ood_per_shift": 15},
  "verify": {"n_cases": 4, "seed": 11},
  "train_threads": 2,
  "candidates": [
    {
      "name": "mlp-64x2-smoke",
      "note": "smoke-test model",
      "hidden": 64,
      "depth": 2,
      "epochs": 60,
      "batch_size": 64,
      "lr": 0.003,
      "seed": 0,
      "train_fraction": 1.0,
      "loss_weights": {"t_cool": 10.0, "field": 1.0, "heat": 1.0}
    }
  ],
  "quantize": "mlp-64x2-smoke",
  "gate": {"max_t_cool_rel_error_p95": 1.0, "max_field_rmse_k_mean": 100.0, "max_violation_rate": 1.0},
  "evaluation": {"bootstrap": 200, "seed": 0},
  "speed": {"solver_cases": 2, "repeats": 20},
  "traffic": {"n_in_box": 20, "n_out_of_box": 5, "shadow_sample": 10, "seed": 3},
  "monitor": {"max_out_of_box_rate": 0.05, "max_shadow_t_cool_rel_error_p95": 0.02}
}
